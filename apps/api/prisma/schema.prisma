// Clowe database schema — Phase 1.
// Full e-commerce data model: users & auth, sellers, catalog, cart,
// orders & payments, reviews/returns, referrals, AI try-on, notifications.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  BANNED // permanent — the shop and its listings stay off the storefront
}

enum KycCheckType {
  PAN
  GSTIN
  BANK
}

// VERIFIED and FAILED are the provider's answers and are never asked again.
// ERROR is the absence of one; only a deliberate retry calls the provider again.
enum KycCheckOutcome {
  VERIFIED
  FAILED
  ERROR
}

// The verification provider's own name-match bands, best first.
enum NameMatchBand {
  DIRECT_MATCH
  GOOD_PARTIAL_MATCH
  MODERATE_PARTIAL_MATCH
  POOR_PARTIAL_MATCH
  NO_MATCH
}

// Where the shop's KYC paperwork stands, set by the admin during review.
enum SellerKycStatus {
  PENDING_DOCS
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING // submitted, waiting for admin approval
  APPROVED // live on the storefront
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED // seller has picked & packed the item, awaiting courier pickup
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  // The parcel could not be delivered and is on its way back to the seller
  // (Delhivery RT scans); then back with the seller. Not a sale.
  RTO_IN_TRANSIT
  RTO_DELIVERED
}

/// FORWARD: seller to buyer. REVERSE: a return picked up from the buyer.
enum ShipmentKind {
  FORWARD
  REVERSE
}

/// Where a parcel is, in our words; mapped from the courier's scans.
enum ShipmentStatus {
  CREATED // manifested: AWB issued, label printable, not yet handed over
  PICKUP_REQUESTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_FAILED // an attempt failed (NDR); the courier will try again or return it
  DELIVERED
  RTO_IN_TRANSIT
  RTO_DELIVERED
  CANCELLED
  LOST
}

/// A seller's pickup address as registered with the courier (a Delhivery "warehouse").
enum CourierWarehouseStatus {
  NONE
  PENDING
  ACTIVE
  FAILED
}

enum PaymentStatus {
  CREATED // Razorpay order created, awaiting payment
  PAID
  FAILED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum ReturnReason {
  SIZE_FIT
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  MISSING_PARTS
  NOT_AS_DESCRIBED
  QUALITY
  CHANGED_MIND
  OTHER
  // Appended for the Return Policy's claims (2.1): spurious or counterfeit.
  COUNTERFEIT
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ReferralStatus {
  PENDING // referred user signed up, reward not yet unlocked
  CREDITED // reward granted (e.g. after first delivered order)
}

enum TryOnStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PayoutStatus {
  PENDING // requested by the seller, not yet sent to the bank
  PROCESSING // handed to the payout provider
  PAID // money credited (UTR recorded)
  FAILED
}

enum PayoutMethodType {
  BANK
  UPI
}

enum PromotionScope {
  STORE // every listing in the shop
  PRODUCT // a chosen set of products
  CATEGORY // everything the seller lists in chosen categories
}

enum PromotionKind {
  PERCENT // % off, optionally capped
  FLAT // flat rupees off the eligible subtotal
}

// What the seller set; the running/scheduled/expired view is derived.
enum PromotionState {
  DRAFT
  ACTIVE
  PAUSED
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditStatus {
  SUCCESS
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER // waiting on the shopper to come back to us
  RESOLVED
  CLOSED
}

// How the ticket reached us.
enum SupportChannel {
  CHAT
  EMAIL
  WEB
  APP
  WHATSAPP
  PHONE
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  phone        String    @unique // E.164-ish, 10-digit Indian mobile stored without +91
  name         String?
  email        String?   @unique
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  /// Marked by an admin: may order while the store is closed, and pay through
  /// the mock gateway on production (owner's pre-launch switch).
  isTestAccount Boolean  @default(false)
  // Profile
  dateOfBirth  DateTime?
  gender       String? // MALE | FEMALE | OTHER | PREFER_NOT_TO_SAY
  avatarUrl    String?
  // Optional "About you" profile — feeds recommendations, never shown publicly.
  location           String?
  profession         String?
  interests          String[] @default([])
  favouriteBrands    String[] @default([])
  preferredCategories String[] @default([])
  // Set once the shopper confirms their email address.
  emailVerifiedAt    DateTime?
  // The one-time confirmation link (sha256 of its token) and when it was sent; cleared once used.
  emailVerifyTokenHash String?  @unique
  emailVerifySentAt  DateTime?
  // Quick-login PIN (4 digits, hashed; OTP always works as fallback)
  pinHash     String?
  pinAttempts Int     @default(0)
  // Notification preferences (OTP + order-critical messages always sent)
  notifyEmail    Boolean @default(true)
  notifySms      Boolean @default(true)
  notifyWhatsapp Boolean @default(true)
  personalizedRecs Boolean @default(true)
  referralCode String   @unique // shareable code for the referral program
  // Shopping credits: earned on paid orders (1 per ₹20), 1 credit = 50 paise.
  creditsBalance Int @default(0)
  // Orders of theirs that came back undelivered (RTO). Shown to sellers and
  // admins; never blocks ordering.
  rtoCount       Int @default(0)
  // Premium membership: free standard delivery with no minimum order.
  isPremium      Boolean   @default(false)
  premiumSince   DateTime?
  // Set the first time the shopper shares their wishlist; revoking clears it.
  wishlistShareToken String?  @unique
  // Saved photo for AI try-on — uploaded once, reused on every "Try On Me"
  // (deleted with every try-on photo 24 hours after upload).
  tryOnPhotoUrl String?
  // The Terms and Privacy Policy version accepted at sign-in, and when.
  termsVersion    String?
  termsAcceptedAt DateTime?
  // Consent to use AI Try-On (18+, the photo is of them or of a consenting
  // adult): when, and which wording. Null = not given, or withdrawn.
  tryOnConsentAt      DateTime?
  tryOnConsentVersion String?
  // Return Policy 4.3 / 8.1: placed under review after a claim failed quality
  // check (used, altered, substituted). Seen by admins; cleared by them.
  claimsReviewAt   DateTime?
  claimsReviewNote String?
  referredById String?
  referredBy   User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]   @relation("UserReferrals")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellerProfile    SellerProfile?
  refreshTokens    RefreshToken[]
  addresses        Address[]
  cart             Cart?
  orders           Order[]
  wishlistItems    Wishlist[]
  reviews          Review[]
  returns          Return[]
  referralsGiven   Referral[]     @relation("Referrer")
  referralReceived Referral?      @relation("Referred")
  tryOnHistory     TryOnHistory[]
  notifications    Notification[]
  complaints       Complaint[]
  creditLedger     CreditLedger[]
  productViews     ProductView[]
  paymentMethods   SavedPaymentMethod[]
  creditPurchases  CreditPurchase[]
  promotionRedemptions PromotionRedemption[]
  sellerNotes          SellerNote[]
  ticketMessages       SupportTicketMessage[]
  auditLogs            AuditLog[]
  sellerLedgerEntries  SellerLedgerEntry[] @relation("SellerLedgerCreatedBy")
  assignedComplaints   Complaint[]        @relation("ComplaintAssignee")
  complaintMessages    ComplaintMessage[]
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]    @relation("PurchaseOrderAuthor")
  stockTransfers       StockTransfer[]    @relation("StockTransferAuthor")
  ordersPlacedForOthers Order[]           @relation("OrderPlacedByAdmin")
  refundsIssued         Refund[]          @relation("RefundIssuedByAdmin")

  @@map("users")
  assets      Asset[]
}

// Audit trail for shopping credits (positive = earned, negative = spent).
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int // credits, signed
  reason    String // EARN_PURCHASE | EARN_REFERRAL | EARN_TOPUP | REDEEM_CHECKOUT | REFUND_CREDITS | REVERSE_PURCHASE | EXPIRED
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Earned credits lapse after CREDIT_EXPIRY_MONTHS; spends leave this null.
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
  @@map("credit_ledger")
}

enum CreditPurchaseStatus {
  CREATED
  PAID
  FAILED
}

// A top-up: the shopper buys credits outright through the payment gateway.
model CreditPurchase {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId         String
  credits           Int // base credits
  bonusCredits      Int                  @default(0)
  amountPaise       Int
  provider          String               @default("mock")
  providerOrderId   String?
  providerPaymentId String?
  status            CreditPurchaseStatus @default(CREATED)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, createdAt])
  @@map("credit_purchases")
}

// One-time passwords for phone login. Codes are stored hashed.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0) // wrong-guess counter
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

/// One attempt to send a login code through the SMS panel, and what the panel
/// answered — kept in the database so a code that never arrived can still be
/// traced after a deploy has replaced the container and its log. Never the
/// code, the API key or the full number.
model OtpSendLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  /// xxxxxx3821
  phoneMasked  String
  host         String
  accepted     Boolean
  /// Why it was not sent (an OtpSendFailure); null when accepted.
  reason       String?
  httpStatus   Int?
  panelStatus  String?
  panelMessage String?
  /// What the panel's delivery report is searched by.
  messageId    String?
  /// The failure in words, as logged; null when accepted.
  detail       String?
  durationMs   Int

  @@index([createdAt])
  @@index([phoneMasked, createdAt])
  @@map("otp_send_logs")
}

// Refresh tokens are stored hashed; rotation revokes the old one.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Sellers
// ---------------------------------------------------------------------------

model SellerProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName        String
  description     String?
  // KYC-lite fields
  gstNumber       String?
  panNumber       String?
  // Name exactly as printed on the PAN; what the PAN check scores against.
  panName           String?
  bankName        String?
  bankAccountName String?
  bankAccountNo   String?
  bankIfsc        String?
  // The seller's bank account as entered in Store Settings: the number
  // AES-256-GCM encrypted (bankAccountEnc), shown by its last 4 digits, with
  // the account type and a cancelled cheque (private asset ref) to verify it.
  // bankAccountNo is the old plain column and stays empty for new entries.
  bankAccountEnc   String?
  bankAccountLast4 String?
  bankAccountType  String?
  bankChequeDoc    String?
  bankSubmittedAt  DateTime?
  // Onboarding exception (an admin's, per seller): while on — and only until
  // the store opens for orders, or the optional end date — approved listings
  // may be live without a complete business address or KYC. Never for payouts.
  onboardingException       Boolean   @default(false)
  onboardingExceptionReason String?
  onboardingExceptionUntil  DateTime?
  onboardingExceptionSetAt  DateTime?
  onboardingExceptionSetBy  String?
  addressLine1    String?
  city            String?
  state           String?
  pincode         String?
  status          SellerStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  // The application (Vendor Terms 2.1): submitted when, the documents with
  // it (private "asset:" references), and an admin's request for more.
  applicationSubmittedAt DateTime?
  constitutionDoc        String?
  cancelledChequeDoc     String?
  signatoryKycDoc        String?
  brandAuthorisationDoc  String?
  infoRequest            String?
  infoRequestedAt        DateTime?
  // The Vendor Terms version last accepted (history in seller_terms_acceptances).
  vendorTermsVersion     String?
  vendorTermsAcceptedAt  DateTime?
  termsAcceptances       SellerTermsAcceptance[]
  // Registered entity type, e.g. Proprietorship / Private Limited.
  businessType    String?
  kycStatus       SellerKycStatus @default(PENDING_DOCS)
  kycReviewedAt   DateTime?
  // Set while automated KYC checks run, so a double-click or a second API
  // instance cannot pay for the same verification twice. Cleared when done;
  // a stale value (crashed run) is taken over after a couple of minutes.
  kycCheckStartedAt DateTime?
  // Why the shop was suspended or banned (shown to the seller).
  suspensionReason String?
  suspendedAt      DateTime?
  // AI Try-On credits: each successful shopper run on this shop deducts one
  // (the sum of the unexpired lots). The first approved sellers get free
  // credits (tryOnFreeGrant marks who received them; owner's Batch 2).
  tryOnCredits   Int     @default(0)
  tryOnFreeGrant Boolean @default(false)
  /// A pack bought every month (its credits), and when it renews next.
  tryOnPackRenewCredits Int?
  tryOnPackRenewAt      DateTime?
  /// When the seller was told the credits ran out (cleared by a top-up).
  tryOnZeroNotifiedAt   DateTime?
  tryOnCreditLots       TryOnCreditLot[]
  // Admin's VIP flag: no handling fee, whatever the plan.
  vip            Boolean @default(false)
  subscription   SellerSubscription?
  taxInvoices    SellerTaxInvoice[]
  adCampaigns    AdCampaign[]
  tryOnCreditLedger TryOnCreditLedger[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // --- Storefront ---------------------------------------------------------
  // Public store URL: /store/<slug>.
  slug          String?  @unique
  tagline       String?
  logoUrl       String?
  bannerUrl     String?
  storeEmail    String?
  storePhone    String?
  // Trust chips on the store page: [{ icon, title, subtitle }].
  highlights    Json?
  // { website, instagram, facebook, youtube }
  socialLinks   Json?
  // What this shop mainly sells — drives the store page's category line.
  primaryCategoryId String?
  addressLine2  String?
  landmark      String?

  // --- Pickup address (printed on shipping labels) ------------------------
  pickupSameAsBusiness Boolean @default(true)
  pickupName    String?
  pickupPhone   String?
  pickupLine1   String?
  pickupLine2   String?
  pickupCity    String?
  pickupState   String?
  pickupPincode String?
  // The pickup address as registered with the courier. The name never
  // changes once set (Delhivery matches it exactly); a new address that the
  // courier cannot edit in place gets a new, versioned name.
  courierWarehouseName      String?
  // A second warehouse at the seller's separate return address (customer
  // returns are delivered to the warehouse a reverse pickup names); null when
  // returns go to the pickup address.
  courierReturnWarehouseName String?
  courierWarehouseStatus    CourierWarehouseStatus @default(NONE)
  courierWarehouseError     String?
  courierWarehouseSyncedAt  DateTime?
  // Fingerprint of the address last registered, to notice an edit.
  courierWarehouseAddressHash String?

  // --- Fulfilment preferences --------------------------------------------
  // Working days allowed to dispatch before a shipment counts as late.
  dispatchDays  Int      @default(2)
  // Seller can opt out of Cash on Delivery for their own items.
  codEnabled    Boolean  @default(true)
  // Overrides the platform return window when set.
  returnWindowDays Int?
  returnAddressSameAsPickup Boolean @default(true)
  returnLine1   String?
  returnCity    String?
  returnState   String?
  returnPincode String?

  // --- Availability -------------------------------------------------------
  // { mon: { open, close, closed }, ... } — shown on the store page.
  workingHours  Json?
  // Vacation mode hides the shop's listings without archiving anything.
  vacationMode  Boolean   @default(false)
  // Seeded demo store (prisma/seed). Hidden from shoppers, with every
  // product it carries, while PlatformSettings.demoCatalogEnabled is off.
  isDemo        Boolean   @default(false)
  vacationUntil DateTime?
  // When vacation mode was last switched on and off. Vacation stops the
  // late-dispatch penalty clock, and these say for how long.
  vacationStartedAt DateTime?
  vacationEndedAt   DateTime?
  vacationMessage String?

  // Seller-to-seller referral program.
  referralCode String? @unique // SLR-XXXXXX

  products          Product[]
  orderItems        OrderItem[]
  shipments         Shipment[]
  ads               Ad[]
  referralsGiven    SellerReferral[] @relation("SellerReferrer")
  referralsReceived SellerReferral[] @relation("SellerReferred")
  payouts           Payout[]
  payoutMethods     SellerPayoutMethod[]
  packingVideos     OrderPackingVideo[]
  promotions        Promotion[]
  notes             SellerNote[]
  tickets           SupportTicket[]
  customerComplaints Complaint[]
  kycChecks         SellerKycCheck[]
  kycReviews        SellerKycReview[]
  brandProofs       SellerBrandProof[]
  ledgerEntries     SellerLedgerEntry[]
  promotionCreditPurchases PromotionCreditPurchase[]

  @@map("seller_profiles")
}

// A seller's support request, with the full back-and-forth attached.
model SupportTicket {
  id          String         @id @default(cuid())
  reference   String         @unique // TK-000123
  sellerId    String
  seller      SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // ACCOUNT | LISTING | ORDERS | PAYOUTS | RETURNS | POLICY | TECHNICAL | OTHER
  category    String
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  // Optional context the seller attached.
  orderNumber String?
  productId   String?
  // Set when the ticket is closed out.
  resolvedAt  DateTime?
  closedAt    DateTime?
  // The seller's verdict once it's resolved (1–5) plus optional comment.
  rating         Int?
  ratingComment  String?
  // Timestamp of the first staff reply — feeds the response-time metric.
  firstReplyAt DateTime?
  lastMessageAt DateTime     @default(now())
  // When an admin last opened it in the support inbox (unread = seller messages since).
  adminReadAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages SupportTicketMessage[]

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // SELLER | ADMIN — who is speaking, independent of the account's role.
  authorRole String
  body      String
  attachments String[]    @default([])
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

// Admin-only note on a shop — never shown to the seller.
model SellerNote {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now())

  @@index([sellerId, createdAt])
  @@map("seller_notes")
}

/// One call to the KYC verification provider, append-only.
///
/// Every row is a call that may have been billed, so the table doubles as a
/// ledger of what verification cost. The latest row per check is its status.
///
/// What it holds is the outcome — status, score, band, provider, time — and
/// never the provider's response: no registered names, no bank-side account
/// holder, nothing the provider returned beyond the verdict.
/// An admin's manual decision on a seller's PAN, GSTIN or bank account, made
/// against the documents (the fallback while no real verification provider is
/// set up, and an override after one). The latest decision or real-provider
/// answer for the details on file is what counts; a mock answer never does.
enum KycReviewStatus {
  VERIFIED
  REJECTED
}

model SellerKycReview {
  id         String          @id @default(cuid())
  sellerId   String
  seller     SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  kind       KycCheckType
  status     KycReviewStatus
  /// Fingerprint (HMAC) of the details decided on: a change to them needs a new decision.
  subject    String
  reason     String?
  reviewerId String
  createdAt  DateTime        @default(now())

  @@index([sellerId, kind, createdAt])
  @@map("seller_kyc_reviews")
}

/// A seller's proof for a brand that needs authorization (an authorization
/// letter from the brand or its distributor, or a GST purchase invoice from
/// them). Approved, it covers all that seller's listings of the brand until
/// the optional expiry.
model SellerBrandProof {
  id          String          @id @default(cuid())
  sellerId    String
  seller      SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  /// AUTHORIZATION_LETTER or PURCHASE_INVOICE
  proofType   String
  /// Private asset ref (seller document upload).
  doc         String
  status      BrandAuthStatus @default(PENDING)
  note        String?
  expiresAt   DateTime?
  submittedAt DateTime        @default(now())
  reviewedAt  DateTime?
  reviewerId  String?

  @@unique([sellerId, brandId])
  @@index([status, submittedAt])
  @@map("seller_brand_proofs")
}

model SellerKycCheck {
  id          String          @id @default(cuid())
  sellerId    String
  seller      SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  kind        KycCheckType
  outcome     KycCheckOutcome
  /// Our own reason code (PAN_INVALID, FRAUD_ACCOUNT, PROVIDER_BALANCE…), never provider text.
  reason      String?
  /// The provider's 0–100 name match, and its band. Null when no name was checked.
  nameScore   Int?
  nameBand    NameMatchBand?
  /// Which provider answered. Answers from one never count for another: a
  /// mock "verified" must not stand once the real provider is switched on.
  provider    String
  /// HMAC of what was checked — the PAN, the GSTIN, or account number + IFSC.
  /// Tells whether the details on file changed since, without keeping a
  /// second copy of the number.
  subject     String
  /// HMAC of the name sent for matching; null when none was sent.
  nameSubject String?
  createdAt   DateTime        @default(now())

  @@index([sellerId, kind, createdAt])
  @@map("seller_kyc_checks")
}

// Where a seller's money is sent. Account numbers are stored masked — the
// full number lives with the payout provider, never in this table.
model SellerPayoutMethod {
  id          String           @id @default(cuid())
  sellerId    String
  seller      SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type        PayoutMethodType @default(BANK)
  label       String // e.g. "HDFC Bank"
  accountName String
  // Last 4 digits only, for display.
  accountLast4 String?
  ifsc         String?
  upiId        String?
  isDefault    Boolean         @default(false)
  // Penny-drop verification (mock in dev).
  verified     Boolean         @default(false)
  verifiedAt   DateTime?
  createdAt    DateTime        @default(now())

  payouts Payout[]

  @@index([sellerId, isDefault])
  @@map("seller_payout_methods")
}

// One settlement run: the order items it paid for, the fees withheld and the
// bank reference. Amounts are snapshots — re-reading fees later can't change
// what was actually paid.
model Payout {
  id         String        @id @default(cuid())
  reference  String        @unique // PAYOUT-000024
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  periodFrom DateTime
  periodTo   DateTime

  grossPaise      Int // sum of settled item line totals
  commissionPaise Int @default(0) // platform/referral fee
  gatewayPaise    Int @default(0) // payment gateway charges
  otherFeesPaise  Int @default(0)
  adjustmentPaise Int @default(0) // ad spend and other recoveries
  tdsPaise        Int @default(0) // section 194-O withholding
  tcsPaise        Int @default(0) // GST TCS collected under s.52 (GSTR-8)
  netPaise        Int // what actually leaves for the bank

  status        PayoutStatus        @default(PENDING)
  methodId      String?
  method        SellerPayoutMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  // Snapshot so the row still explains itself if the method is deleted.
  methodLabel   String?
  utr           String? // bank reference once paid
  failureReason String?
  requestedAt   DateTime            @default(now())
  processedAt   DateTime?

  items OrderItem[]
  ads   Ad[]
  ledgerEntries SellerLedgerEntry[]

  @@index([sellerId, requestedAt])
  @@map("payouts")
}

enum SellerReferralStatus {
  PENDING // waiting for the referred seller's delivered sales to cross the target
  EARNED // reward credited to the referrer
  VOID // voided by admin (fraud/abuse)
}

// One row per referred seller (a seller can be referred at most once).
model SellerReferral {
  id          String               @id @default(cuid())
  referrerId  String
  referrer    SellerProfile        @relation("SellerReferrer", fields: [referrerId], references: [id])
  referredId  String               @unique
  referred    SellerProfile        @relation("SellerReferred", fields: [referredId], references: [id])
  status      SellerReferralStatus @default(PENDING)
  rewardPaise Int                  @default(0)
  earnedAt    DateTime?
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime             @default(now())

  @@map("seller_referrals")
}

// ---------------------------------------------------------------------------
// Platform settings & seller ads
// ---------------------------------------------------------------------------

// Admin-editable key-value settings (JSON values, defaults live in code).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

enum AdPlacement {
  HOME_BANNER
  CATEGORY_SPONSORED
}

enum AdStatus {
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
}

// Seller-paid promoted placement. Payment is manual/payout-adjusted for now —
// pricePaise records what is owed (snapshot of admin pricing at submit time).
model Ad {
  id              String        @id @default(cuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  placement       AdPlacement
  durationDays    Int
  pricePaise      Int
  status          AdStatus      @default(PENDING)
  rejectionReason String?
  startAt         DateTime?
  endAt           DateTime?
  views           Int           @default(0)
  clicks          Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Ad spend is recovered from a payout; set once that has happened.
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  ledgerEntries SellerLedgerEntry[]

  @@index([status, placement])
  @@index([sellerId, payoutId])
  @@map("ads")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  // Small emoji/glyph for the category nav bar and mega menu.
  icon      String?
  // Category landing page content.
  description String?
  // Referral fee for products in this category, percent of the selling price (Batch 2).
  referralPercent Float @default(2)
  // Subcategory tile shape on the landing rail: "square" | "circle".
  tileShape   String  @default("square")
  // Hero side-card bullets: [{ icon, title, subtitle }].
  highlights  Json?
  // Bottom feature strip: [{ icon, title, subtitle }].
  features    Json?
  // --- Marketplace rules (null / empty = inherit from the parent category) ---
  // Option axes variants in this department use: [{ key, label, values? }].
  variantAxes      Json?
  // Spec-sheet fields sellers fill in: [{ key, label, type, unit?, required?, options? }].
  attributeSchema  Json?
  // Filter facets: { add, hide, order } applied to the parent's set (shared/facets.ts).
  facets           Json?
  // AI Try-On and the size guide only make sense for wearables.
  tryOnEligible    Boolean?
  sizeGuide        Boolean?
  // GST default for listings without their own slab: a flat rate, or
  // taxRule = VALUE_SLAB: GST 2.0 slab, 5% up to Rs 2,500 per piece ex-GST, 18% above
  // (both rates and the threshold are platform settings). gstRateFor decides every rate.
  taxRule               String?
  defaultTaxRatePercent Int?
  hsnCode               String?
  // Days after delivery a return can be requested (null = platform default).
  returnWindowDays Int?
  // Whether products here can be returned at all (null = as the parent; the
  // root default is yes). Innerwear, for one, is not.
  returnable Boolean?
  isActive  Boolean    @default(true)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  products Product[]
  banners  CategoryBanner[]

  @@map("categories")
}

// Hero carousel on a category landing page (mirrors HomeBanner, scoped to a
// category). Several rows = several slides.
model CategoryBanner {
  id           String   @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  eyebrow      String?
  headline     String
  // Accented tail of the headline, e.g. "New You." rendered in gold.
  highlight    String?
  subtext      String?
  imageUrl     String?
  primaryLabel String   @default("Shop Now")
  primaryHref  String?
  imageMode    BannerImageMode @default(DESIGNED)
  altText      String?
  mobileImageUrl String?
  /// The point (percent across, percent down) that must stay in view at every width.
  focalX         Int      @default(50)
  focalY         Int      @default(50)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId, isActive, sortOrder])
  @@map("category_banners")
}

// Marketplace brand ("Top Brands" row, brand-filtered listings). Product.brand
// (string) stays as the display snapshot; brandId links catalogue products.
model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  // Listings of this brand stay hidden from shoppers until the seller uploads
  // a brand authorization document and an admin approves it.
  authorizationRequired Boolean @default(false)
  createdAt DateTime @default(now())

  products Product[]
  sellerProofs SellerBrandProof[]

  @@map("brands")
}

/// A listing's brand authorization document, for brands that need one.
enum BrandAuthStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Product {
  id              String        @id @default(cuid())
  sellerId        String
  seller          SellerProfile @relation(fields: [sellerId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  title           String
  slug            String        @unique
  description     String
  // One-line pitch shown on cards and in search results.
  shortDescription String?
  brand           String?
  brandId         String?
  brandRef        Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  // Brand authorization (a brand an admin marked "authorization required"):
  // the seller's document (a private asset ref) and the admin's decision.
  brandAuthDoc         String?
  brandAuthStatus      BrandAuthStatus @default(NONE)
  brandAuthNote        String?
  brandAuthSubmittedAt DateTime?
  brandAuthReviewedAt  DateTime?
  // Prices in paise (integer) to avoid floating-point money bugs.
  basePricePaise  Int
  // List price for strike-through / "% OFF". Null = no discount shown.
  mrpPaise        Int?
  // Denormalised rating cache — synced whenever a review is written, so
  // listing/landing queries never re-aggregate the reviews table.
  ratingAvg       Float         @default(0)
  ratingCount     Int           @default(0)
  soldCount       Int           @default(0)
  viewCount       Int           @default(0)
  // Key-feature bullets for the product page: string[].
  highlights      Json?
  // Spec sheet the seller fills in: [{ key, label, value }] (see shared/productAttributes).
  attributes      Json?
  // Optional YouTube/Vimeo link shown beside the gallery.
  videoUrl        String?
  // Mandatory packing video uploaded at listing time; auto-removed after 10 days.
  packingVideoUrl        String?
  packingVideoUploadedAt DateTime?
  // GST slab for this listing; null falls back to the category rule.
  // Logistics, used for shipping estimates and the packing slip.
  weightGrams     Int?
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  shippingTemplate String?      // STANDARD | EXPRESS | HEAVY
  // Search/meta overrides; empty falls back to the title/description.
  metaTitle       String?
  metaDescription String?
  tags            String[]      @default([])
  /// Weighted tsvector kept up to date by the database itself (see the
  /// product_search_fts migration). Declared here only so Prisma stops
  /// treating it as drift — without this line every future `migrate dev`
  /// generates a DROP for it and silently removes full-text search.
  searchVector    Unsupported("tsvector")?
  /// Every colour the variants come in, names and families ("Navy Blue"),
  /// for the search vector. Kept in step by a trigger on product_variants
  /// (the search_colors migration); never written by the app.
  searchColors    String        @default("")
  // Seller's own switch — hides an approved listing without archiving it.
  isVisible       Boolean       @default(true)
  // Over the plan's live-product limit (owner's Batch 2): hidden from shoppers,
  // never deleted; live again when the seller picks it or upgrades.
  planHidden      Boolean       @default(false)
  // 360° view (Pro and Premium plans): images taken around the product, in
  // order; the product page spins through them as the shopper drags.
  spinImages      String[]      @default([])
  /// A new 360° view waiting for admin review; the live one stays until approved.
  spinImagesPending String[]    @default([])
  spinImagesSubmittedAt DateTime?
  adCampaigns     AdCampaign[]
  // Seller opt-in for AI Try-On; only honoured in try-on eligible categories.
  tryOnEnabled    Boolean       @default(false)
  // Seller's "Not returnable" (pierced jewellery, customised or final-sale
  // items). Can only make a product non-returnable: a non-returnable
  // category wins whatever this says.
  nonReturnable   Boolean       @default(false)
  // "Non-cancellable" (Cancellation Policy 2.1): customised, made-to-measure
  // or final-sale. Shown before ordering; cannot be cancelled once confirmed.
  nonCancellable  Boolean       @default(false)
  // Optional per-product cap on shopper try-ons; null = until credits run out.
  tryOnLimit      Int?
  tryOnUsed       Int           @default(0)
  // Inventory guards.
  lowStockAlert   Int           @default(5)
  allowBackorders Boolean       @default(false)
  // Landing-page badges.
  isBestSeller    Boolean       @default(false)
  isNew           Boolean       @default(false)
  isTrending      Boolean       @default(false)
  status          ProductStatus @default(DRAFT)
  rejectionReason String?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  variants      ProductVariant[]
  images        ProductImage[]
  wishlistItems Wishlist[]
  reviews       Review[]
  orderItems    OrderItem[]
  tryOnHistory  TryOnHistory[]
  ads           Ad[]
  views         ProductView[]
  dealItems     DealItem[]

  @@index([status, categoryId])
  @@index([sellerId])
  @@index([status, soldCount])
  // Containment lookups by the filter facets on the spec sheet ("attributes" @> '[{"key": "fabric", "value": "Cotton"}]').
  @@index([attributes(ops: JsonbPathOps)], type: Gin)
  @@map("products")
  revision    ProductRevision?
}

// One row per storefront product-detail view — powers "Trending Now"
// (views + sales in the last 7 days).
model ProductView {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Null for logged-out visitors — those views only feed the trending signal.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@map("product_views")
}

// A payment instrument the shopper saved for faster checkout. Only the
// gateway-safe display fields are stored — never a full card number or CVV.
model SavedPaymentMethod {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // CARD | UPI | WALLET
  kind        String   @default("CARD")
  // Name printed on the card (cards only).
  holderName  String?
  // Visa / Mastercard / RuPay for cards; the UPI handle's app for UPI.
  brand       String
  // Last 4 digits (cards) or the masked VPA (UPI).
  label       String
  expiryMonth Int?
  expiryYear  Int?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("saved_payment_methods")
}

// Buyable variants. `size`/`color` remain the canonical unique display columns
// (cart, orders, seller flows unchanged); `optionValues` additionally stores
// the structured attributes for non-clothing products (e.g. {"storage":"256GB",
// "ram":"8GB","color":"Black"}), with the non-color axes packed into `size`
// for display. Later phases render optionValues natively.
model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Source of truth: the option combination, e.g. { size, color } or { ram, storage }.
  optionValues Json     @default("{}")
  // Canonical "key=value|key=value" of optionValues - the per-product uniqueness key.
  optionsKey   String   @default("")
  // Human label derived from optionValues ("Black · L"); "" for single-SKU products.
  label        String   @default("")
  // Display caches of optionValues.size / .color ("" when the axis does not apply).
  size         String   @default("")
  color        String   @default("")
  sku          String   @unique
  // What the buyer pays, GST included: what every shopper-facing screen, the
  // cart and checkout read. Written from the seller's price (below) plus GST.
  pricePaise   Int
  mrpPaise     Int? // strike-through price, GST included
  // What the seller entered, BEFORE GST. Null on rows priced before sellers
  // entered ex-GST and not yet backfilled (prisma/backfillSellerPrices.ts):
  // those are read through sellerPriceFromBuyer.
  sellerPricePaise Int?
  sellerMrpPaise   Int?
  stock        Int      @default(0)
  createdAt    DateTime @default(now())
  // Set when the seller removes a variant that has been ordered: its order
  // lines still point at it (stock goes back here on a cancel or return), so
  // it cannot be deleted. Retired variants are invisible everywhere but those
  // orders; their optionsKey is freed so the combination can be added again.
  retiredAt    DateTime?

  cartItems  CartItem[]
  orderItems OrderItem[]
  // Pictures for this variant specifically; empty means it shows the product's.
  images     ProductVariantImage[]
  // Where this variant's stock sits, and the ledger of how it moved.
  stockLocations     StockLocation[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      StockTransferItem[]

  @@unique([productId, optionsKey])
  // Containment lookups by the filter facets ("optionValues" @> '{"color_family": "Blue"}').
  @@index([optionValues(ops: JsonbPathOps)], type: Gin)
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
  /// An internal note on the picture, e.g. "low-res, replace later" (never shown to shoppers).
  qualityNote String?

  @@map("product_images")
}

/// Pictures of one variant, kept in their own table rather than as a nullable
/// column on product_images.
///
/// Forty-odd queries across the API load `product.images` — card thumbnails,
/// the suggest dropdown, order rows, the PDP gallery — almost all of them
/// `take: 1` ordered by sortOrder. A variantId column on that table would put
/// variant pictures into every one of those results, so each would need a
/// `where: { variantId: null }` it does not have today, and the next such query
/// someone writes would silently pick up the wrong thumbnail.
///
/// A separate table cannot leak that way: `product.images` keeps meaning
/// exactly what it means now, and a variant's pictures are reachable only by
/// asking a variant for them. The cost is one small table; the alternative was
/// a rule to remember in forty places.
model ProductVariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int            @default(0)

  @@index([variantId, sortOrder])
  @@map("product_variant_images")
}

// ---------------------------------------------------------------------------
// Addresses, cart, wishlist
// ---------------------------------------------------------------------------

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Shown as a chip on the address card at checkout.
  label     AddressLabel @default(HOME)
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  orders Order[]

  @@map("addresses")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Coupon the shopper applied on the cart page. Re-validated on every cart
  // read and again at checkout, so a code that expires meanwhile just drops off.
  couponCode String?
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  // Unticked lines stay in the cart but are excluded from totals and checkout.
  selected  Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
  @@map("cart_items")
}

enum CouponType {
  PERCENT
  FLAT
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
  SAME_DAY
}

// Promo code applied at the cart. Percent coupons take `value` as a
// percentage (optionally capped by maxDiscountPaise); flat coupons take it
// as paise off.
model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique // stored uppercase
  description      String?
  type             CouponType
  value            Int
  minSubtotalPaise Int        @default(0)
  maxDiscountPaise Int?
  isActive         Boolean    @default(true)
  startsAt         DateTime?
  expiresAt        DateTime?
  // Total redemptions allowed across all users (null = unlimited).
  usageLimit       Int?
  usedCount        Int        @default(0)
  // How many times ONE shopper may redeem it (null = unlimited).
  perUserLimit     Int?
  // STANDARD | BANK | PREMIUM — PREMIUM is redeemable by members only.
  kind             String     @default("STANDARD")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Cheapest price when the item was saved — powers the "Price drop" badge.
  priceAtAddPaise Int?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // human-friendly, e.g. CLW-2026-000123
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  addressId   String?
  address     Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  // Shipping snapshot (kept even if the address is later edited/deleted).
  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String
  status      OrderStatus @default(PLACED)

  subtotalPaise Int
  shippingPaise Int @default(0)
  // Total money off: coupon discount + redeemed credits (creditsUsed × 50).
  discountPaise Int @default(0)
  // Shopping credits redeemed on this order.
  creditsUsed Int @default(0)
  // Coupon snapshot, so the order still explains itself if the code is edited.
  couponCode          String?
  couponDiscountPaise Int     @default(0)
  totalPaise  Int

  // Delivery speed chosen at checkout + the ETA quoted at that moment.
  deliveryMethod DeliveryMethod @default(STANDARD)
  etaFrom        DateTime?
  etaTo          DateTime?

  // Gift wrap / message chosen at checkout.
  isGift      Boolean @default(false)
  giftMessage String?
  // The buyer's own GSTIN for a business purchase (Payment Policy): given at
  // checkout only, printed on the invoice, never added afterwards.
  buyerGstin  String?

  // How the shopper chose to pay: UPI | CARD | NETBANKING | WALLET | EMI | COD.
  paymentMethod    String  @default("UPI")
  // Billing address snapshot (defaults to the shipping address).
  billName         String?
  billLine1        String?
  billLine2        String?
  billCity         String?
  billState        String?
  billPincode      String?

  // Set when an admin placed this for the shopper (phone/manual order) rather
  // than the shopper checking out themselves. Null = placed on the storefront.
  placedByAdminId String?
  placedByAdmin   User?   @relation("OrderPlacedByAdmin", fields: [placedByAdminId], references: [id], onDelete: SetNull)
  // Free-text note an admin left when placing or editing the order.
  adminNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      OrderItem[]
  shipments  Shipment[]
  payment    Payment?
  complaints Complaint[]
  refunds    Refund[]
  packingVideos OrderPackingVideo[]
  creditLedger CreditLedger[]
  promotionRedemptions PromotionRedemption[]

  @@index([userId, createdAt])
  @@map("orders")
}

// One row per product variant per seller. Item-level status lets each
// seller ship/deliver their part of a multi-vendor order independently.
model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  sellerId  String
  seller    SellerProfile  @relation(fields: [sellerId], references: [id])

  // Snapshot at purchase time.
  title      String
  size       String
  color      String
  // Human variant label + option map at purchase time (size/color kept for legacy readers).
  variantLabel String @default("")
  optionValues Json   @default("{}")
  pricePaise Int
  quantity   Int

  status      OrderStatus @default(PLACED)
  packedAt    DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  // The return window this line was sold with, fixed at checkout so a later
  // change to the platform, category or seller window never moves it. Null
  // only on rows written without checkout (tests): those use today's rule.
  returnWindowDays Int?
  // Whether this line could be returned when it was sold, fixed at checkout
  // like the window. Null: rows written without checkout use today's rule.
  returnable Boolean?
  // Sold as non-cancellable (the product's flag at checkout).
  nonCancellable Boolean @default(false)
  // Why a seller or admin cancelled this line, as the buyer was told.
  cancelReason   String?
  // The GST rate this line was sold at, likewise fixed at checkout: invoices,
  // the ledger, payouts and GSTR-8 read it, so a later GST change (the flat
  // 18%) never rewrites a past sale. Null as above.
  gstRatePercent Int?
  // Clowe's fees for this line, fixed at checkout (owner's Batch 2): 1 = the
  // earlier commission/platform/closing/GT model, 2 = referral, GT %,
  // collection and handling fee, each plus GST. feeRates holds the numbers.
  feeModel Int  @default(1)
  feeRates Json?

  // A free replacement for another line (a parcel lost in transit, or an
  // exchange): what it replaces. Its order is paid with REPLACEMENT.
  replacementOfId String?
  replacementOf   OrderItem?  @relation("Replacement", fields: [replacementOfId], references: [id], onDelete: SetNull)
  replacements    OrderItem[] @relation("Replacement")

  // Delivery partner details (filled when the seller ships via ShippingProvider).
  // Display copies of the line's shipment, kept so existing readers work.
  awbNumber   String?
  courierName String?
  trackingUrl String?
  // The parcel this line travels in: one per order and seller.
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  return Return?

  // Seller promotion applied to this line, and what it took off.
  promotionId        String?
  promotion          Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promoDiscountPaise Int        @default(0)

  // Settlement: set once this line has been paid out to the seller.
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  ledgerEntries SellerLedgerEntry[]

  @@index([sellerId, status])
  // Seller order management sorts by recency within a shop.
  @@index([sellerId, orderId])
  @@index([sellerId, payoutId])
  @@index([replacementOfId])
  @@map("order_items")
}

/// One parcel with the courier. FORWARD: a seller's part of an order (its
/// order lines point here). REVERSE: a return being picked up from the buyer
/// and taken back to the seller's pickup address.
model Shipment {
  id          String         @id @default(cuid())
  kind        ShipmentKind   @default(FORWARD)
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// REVERSE only: the return it carries.
  returnId    String?        @unique
  return      Return?        @relation(fields: [returnId], references: [id], onDelete: SetNull)
  /// mock | delhivery
  provider    String
  /// mock | staging | production — which courier system issued the AWB.
  environment String
  awbNumber   String?        @unique
  /// SURFACE | EXPRESS
  mode        String         @default("SURFACE")
  /// PREPAID | COD | PICKUP (reverse)
  paymentType String
  /// What the courier collects from the buyer; 0 unless COD.
  codAmountPaise Int         @default(0)
  /// The box as the seller declared it.
  weightGrams Int
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?
  /// What the courier weighed and charged on (dead or volumetric, higher).
  chargedWeightGrams Int?
  status      ShipmentStatus @default(CREATED)
  /// The courier's own words for the last scan, as shown to people.
  statusText  String?
  lastScanAt  DateTime?
  pickupRequestId String?
  // When Delhivery is asked to come (one request per pickup address and day).
  pickupScheduledFor DateTime?
  // The last thing asked of Delhivery after a failed attempt (NDR).
  ndrAction    String?
  ndrRequestId String?
  ndrActionAt  DateTime?
  // A parcel back with the seller (RTO), as they found it: GOOD (restocked) or DAMAGED.
  rtoReceivedAt        DateTime?
  rtoReceivedCondition String?
  pickupRequestedAt DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  rtoInitiatedAt DateTime?
  rtoDeliveredAt DateTime?
  cancelledAt DateTime?
  // The estimate from dispatch, by the destination's zone (Shipping Policy 3.2).
  etaFrom     DateTime?
  etaTo       DateTime?
  // Failed delivery attempts so far (up to three are made, 6.5).
  deliveryAttempts Int     @default(0)
  // Lost in transit (9.2): flagged when 15 days past etaTo and not traceable,
  // or when the courier says so; then the buyer's choice and when it was made.
  lostFlaggedAt DateTime?
  lostChoice    String?
  lostChoiceAt  DateTime?
  /// A4 | THERMAL_4X6 — the seller's last print.
  labelSize   String?
  /// Freight in paise: the quote at booking, then the courier's final charge.
  estimatedFreightPaise Int?
  // The charged weight finalFreightPaise was priced at; a different one later
  // posts a FREIGHT_ADJUSTMENT.
  freightWeightGrams    Int?
  // Delhivery's COD charge (₹40 or 2 %, plus GST): estimated at booking,
  // posted to the seller's ledger on delivery.
  estimatedCodFeePaise  Int?
  codFeePaise           Int?
  finalFreightPaise     Int?
  rtoFreightPaise       Int?
  /// COD lines are payable only once the courier's remittance for this AWB is matched.
  codRemittedAt     DateTime?
  codRemittanceRef  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items  OrderItem[]
  events ShipmentEvent[]

  @@index([orderId, sellerId])
  @@index([sellerId, status])
  @@index([status, lastScanAt])
  @@map("shipments")
}

/// One courier scan on a shipment, kept once however often it is pushed or
/// polled (the unique tuple makes a replay a no-op).
model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// When the courier says it happened.
  at         DateTime
  /// Courier status words, e.g. "In Transit", "RTO".
  status     String
  /// Courier status type, e.g. UD, DL, RT, PP, PU, CN.
  statusType String
  /// Courier status code, e.g. EOD-74 (empty when none).
  code       String   @default("")
  location   String?
  instructions String?
  /// WEBHOOK | POLL | MOCK
  source     String
  createdAt  DateTime @default(now())

  @@unique([shipmentId, at, status, code])
  @@index([shipmentId, at])
  @@map("shipment_events")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("razorpay")
  providerOrderId   String? // razorpay_order_id
  providerPaymentId String? // razorpay_payment_id
  amountPaise       Int
  status            PaymentStatus @default(CREATED)
  failureReason     String?
  // When the money was taken: the gateway confirmed it, or a COD order was
  // delivered and paid. Kept when the payment is later refunded.
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Reviews & returns
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1..5, validated at the API layer
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("reviews")
}

// How a return is settled once the goods come back.
enum ReturnResolution {
  REFUND // money back to the original payment method
  STORE_CREDIT // Clowe Credits instead of a gateway refund
}

model Return {
  id          String       @id @default(cuid())
  // Human-readable return authorisation number, e.g. RMA-2026-000123.
  rmaNumber   String       @unique
  orderItemId String       @unique
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  // Structured reason + free-text details (details required for OTHER).
  reasonCategory ReturnReason @default(OTHER)
  reason         String // free-text details (legacy rows keep their original text here)
  photos         String[]     @default([])
  status         ReturnStatus @default(REQUESTED)
  // Seller decision trail.
  rejectionReason   String?
  receivedCondition String? // 'OK' | 'DAMAGED' (set on RETURN_RECEIVED)
  approvedAt        DateTime?
  rejectedAt        DateTime?
  // Set when the courier collects the parcel — APPROVED with a pickup date is
  // "in transit", without one it is still waiting for collection.
  pickedUpAt        DateTime?
  receivedAt        DateTime?
  // Warehouse quality check, recorded when the parcel is opened.
  qcPassed          Boolean?
  qcNote            String?
  // Which rules the claim is under: LEGACY (delivered before the Return
  // Policy's claims took effect) or CLAIM (Return Policy 2–7).
  rules             String    @default("LEGACY")
  // CLAIM: what the buyer asked for — EXCHANGE (an identical item) or REFUND.
  remedy            String?
  // CLAIM: evidence (3.2) — the item (photos above), its tag and barcode, the
  // outer packaging and label, and the unboxing video where required.
  tagPhotos         String[]  @default([])
  packagingPhotos   String[]  @default([])
  unboxingVideo     String?
  // A latent defect (3.3): when the buyer noticed it.
  latentNoticedAt   DateTime?
  // EXCHANGE done: the replacement order sent.
  replacementOrderId String?
  // QC failed (4.3): the item was sent back to the buyer on this order.
  sentBackOrderId   String?
  // Pickup not serviceable (7.2): the buyer ships it, with a receipt, and is
  // reimbursed courier charges up to ₹100.
  selfShip          Boolean   @default(false)
  selfShipReceipt   String?
  selfShipCostPaise Int?
  selfShipReimbursedPaise Int?
  selfShipReimbursedAt    DateTime?
  selfShipReimburseRef    String?
  // How the shopper gets their money back.
  resolution        ReturnResolution @default(REFUND)
  // Cash on Delivery returns only: where the buyer wants the money sent.
  codRefundAccount  CodRefundAccount?
  // Admin dispute-resolution override (approving a seller-rejected return).
  adminOverrideAt   DateTime?
  adminOverrideNote String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  refund Refund?
  // The courier pickup that brings it back, once booked.
  reverseShipment Shipment?

  @@index([status, createdAt])
  @@map("returns")
}

// Every refund attempt is logged here (amount, gateway id, status, timestamps).
enum CodRefundMethod {
  UPI
  BANK
}

// Where a Cash on Delivery buyer wants a return's refund sent: there is no
// online payment to refund to, so an admin pays it by hand. The details are
// encrypted (AES-256-GCM); only the last four characters are kept readable,
// for the masked view. Sellers never see this table.
model CodRefundAccount {
  id        String          @id @default(cuid())
  returnId  String          @unique
  return    Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  method    CodRefundMethod
  last4     String
  // "v1:<iv>:<tag>:<ciphertext>", base64 — JSON of the UPI ID or the bank account.
  cipher    String
  createdAt DateTime        @default(now())

  @@map("cod_refund_accounts")
}

model Refund {
  id               String       @id @default(cuid())
  // Null for a goodwill refund an admin issued without a return behind it.
  returnId         String?      @unique
  return           Return?      @relation(fields: [returnId], references: [id])
  // Why an admin issued this outside the normal return flow.
  reason           String?
  issuedByAdminId  String?
  issuedByAdmin    User?        @relation("RefundIssuedByAdmin", fields: [issuedByAdminId], references: [id], onDelete: SetNull)
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id])
  amountPaise      Int
  provider         String
  providerRefundId String? // razorpay refund id (rfnd_…) / mock id
  status           RefundStatus @default(PENDING)
  failureReason    String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Referrals, AI try-on, notifications
// ---------------------------------------------------------------------------

model Referral {
  id                String         @id @default(cuid())
  referrerId        String
  referrer          User           @relation("Referrer", fields: [referrerId], references: [id])
  referredUserId    String         @unique
  referredUser      User           @relation("Referred", fields: [referredUserId], references: [id])
  rewardAmountPaise Int            @default(0)
  status            ReferralStatus @default(PENDING)
  creditedAt        DateTime?
  createdAt         DateTime       @default(now())

  @@map("referrals")
}

model TryOnHistory {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product     @relation(fields: [productId], references: [id])
  inputImageUrl  String
  resultImageUrl String?
  provider       String      @default("mock")
  status         TryOnStatus @default(PENDING)
  costPaise      Int         @default(0) // per-try-on cost log for accounting
  errorMessage   String?
  // Shopper's verdict on the fit: UP | DOWN (null = not rated).
  feedback       String?
  // Size/colour the shopper was viewing when this run was made.
  variantSize    String?
  variantColor   String?
  // Wall-clock time the provider took to return an image (admin monitor).
  durationMs     Int?
  // Where the run came from: MOBILE | TABLET | DESKTOP | OTHER (from UA).
  deviceType     String?
  // Moderation: admin-flagged runs (abusive photo, bad output, policy breach).
  flagged        Boolean     @default(false)
  flagReason     String?
  flaggedAt      DateTime?
  createdAt      DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([userId, productId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([flagged, createdAt])
  @@map("tryon_history")
}

enum SellerPlanKind {
  FREE
  GROWTH
  PRO
  PREMIUM
}

/// A seller's plan (owner's Batch 2): monthly, auto-renewing on the same
/// date, paid from the Seller Wallet first and then from the next payout.
/// Upgrades take effect at once (prorated); downgrades at the next renewal.
/// A renewal that cannot be paid gets graceDays, then the plan drops to FREE.
model SellerSubscription {
  id               String         @id @default(cuid())
  sellerId         String         @unique
  seller           SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan             SellerPlanKind @default(FREE)
  autoRenew        Boolean        @default(true)
  /// The current paid month (null on FREE).
  periodStart      DateTime?
  periodEnd        DateTime?
  /// A downgrade waiting for the renewal date.
  pendingPlan      SellerPlanKind?
  /// A renewal not yet paid: the plan holds until then, then drops to FREE.
  graceUntil       DateTime?
  /// Sellers from before the plans keep every product live until this date.
  limitGraceUntil  DateTime?
  limitNoticeSentAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([periodEnd])
  @@map("seller_subscriptions")
}

/// Clowe's monthly tax invoice to a seller (owner's Batch 2): every Clowe
/// charge in the month — fees, plan, advertising, sponsorship, try-on
/// credits — with GST, from CLOWE PARTNERS LLP. Issued once a month ends;
/// the number and figures are fixed when issued.
model SellerTaxInvoice {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// YYYY-MM (India time)
  month     String
  number    String        @unique
  issuedAt  DateTime      @default(now())
  /// The whole document as issued (lines, taxes, parties).
  document  Json

  @@unique([sellerId, month])
  @@map("seller_tax_invoices")
}

enum AdCampaignKind {
  CPC
  PACKAGE
  PLACEMENT
  SMART
}

enum AdCampaignStatus {
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

/// Advertising and sponsorship (owner's Batch 2). CPC: the seller bids per
/// valid click inside the type's range. PACKAGE: a fixed-price bundle for
/// campaignDays. PLACEMENT: a booked slot (banner, featured seller…) on a
/// calendar. SMART: a budget and a goal, spread across the CPC types.
/// Sponsorship uses the same machinery with sponsorship = true and its own
/// rate card. Creatives are approved before going live.
model AdCampaign {
  id              String            @id @default(cuid())
  sellerId        String
  seller          SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  kind            AdCampaignKind
  sponsorship     Boolean           @default(false)
  name            String
  /// CPC / SMART / PACKAGE: the ad types it runs (CpcAdType values).
  adTypes         String[]          @default([])
  packageKey      String?
  /// PLACEMENT: which (PlacementKind) and, for category spaces, the category.
  placement       String?
  categoryId      String?
  productId       String?
  product         Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// CPC: the seller's bid per valid click.
  bidPaise        Int?
  dailyBudgetPaise   Int?
  monthlyBudgetPaise Int?
  /// SMART: CLICKS or ORDERS, and the whole budget.
  goal            String?
  totalBudgetPaise Int?
  /// PACKAGE / PLACEMENT: what was charged up front.
  pricePaise      Int               @default(0)
  status          AdCampaignStatus  @default(ACTIVE)
  rejectionReason String?
  creativeUrl     String?
  headline        String?
  startAt         DateTime
  endAt           DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  bookings     AdSlotBooking[]
  clicks       AdClick[]
  stats        AdDailyStat[]
  attributions AdAttribution[]

  @@index([status, kind])
  @@index([sellerId, createdAt])
  @@map("ad_campaigns")
}

/// One slot of a space on one day. The unique key is what stops two
/// campaigns (advertising or sponsorship) holding the same slot.
model AdSlotBooking {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  space      String
  /// The category for category spaces; empty otherwise.
  scopeKey   String     @default("")
  day        DateTime   @db.Date
  slot       Int

  @@unique([space, scopeKey, day, slot])
  @@index([campaignId])
  @@map("ad_slot_bookings")
}

/// A click on an ad. Valid (and charged, for CPC) once per shopper or device,
/// product and campaign in 24 hours; never the seller's own, never a bot.
model AdClick {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId   String?
  viewerKey   String
  userId      String?
  valid       Boolean
  reason      String?
  chargedPaise Int       @default(0)
  createdAt   DateTime   @default(now())

  @@index([campaignId, viewerKey, productId, createdAt])
  @@index([userId, productId, createdAt])
  @@map("ad_clicks")
}

model AdDailyStat {
  campaignId   String
  campaign     AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  day          DateTime   @db.Date
  /// The slot it ran in (an ad type or a placement): per-type performance.
  slotType     String     @default("")
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  spendPaise   Int        @default(0)
  orders       Int        @default(0)
  revenuePaise Int        @default(0)

  @@id([campaignId, day, slotType])
  @@map("ad_daily_stats")
}

/// An order line bought within attributionDays of a valid click on its product's ad.
model AdAttribution {
  id           String     @id @default(cuid())
  campaignId   String
  campaign     AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clickId      String
  orderItemId  String     @unique
  revenuePaise Int
  createdAt    DateTime   @default(now())

  @@index([campaignId])
  @@map("ad_attributions")
}

/// Each acceptance of the Vendor Terms and Seller Agreement: which version,
/// when, and from where (kept as evidence of the contract).
model SellerTermsAcceptance {
  id         String        @id @default(cuid())
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  version    String
  acceptedAt DateTime      @default(now())
  ip         String?
  userAgent  String?

  @@index([sellerId, acceptedAt])
  @@map("seller_terms_acceptances")
}

// Customer support complaints raised via the chat bot.
model Complaint {
  id          String          @id @default(cuid())
  complaintId String          @unique // human-readable, e.g. CMP-2026-48213
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category    String // ORDER | PAYMENT | PRODUCT_QUALITY | DELIVERY | ACCOUNT | OTHER
  // One-line summary; falls back to the category when the shopper gave none.
  subject     String?
  description String
  status      ComplaintStatus @default(OPEN)
  priority    TicketPriority  @default(MEDIUM)
  channel     SupportChannel  @default(CHAT)
  adminNotes  String?

  // Desk workflow.
  assignedToId String?
  assignedTo   User?     @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  // When the first reply is due, from the priority's response target (and
  // again from an escalation: the new level acknowledges it).
  slaDueAt      DateTime?
  // Customer Support and Grievance Policy 3–4: SUPPORT → NODAL → GRIEVANCE,
  // and when it must be resolved (1 month for a consumer complaint, 15 days
  // at the Grievance Officer, 24 hours for unlawful content).
  level         String    @default("SUPPORT")
  escalatedAt   DateTime?
  resolveDueAt  DateTime?
  // A complaint about the product itself goes to its seller, who answers
  // within 24 hours (2.4).
  sellerId          String?
  seller            SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerDueAt       DateTime?
  sellerRespondedAt DateTime?
  // Admins were told a timer ran out (once per ticket).
  breachNotifiedAt  DateTime?
  firstResponseAt DateTime?
  resolvedAt    DateTime?
  closedAt      DateTime?
  // The shopper's verdict once it is settled.
  rating        Int?
  ratingComment String?
  lastMessageAt DateTime @default(now())
  // When an admin last opened it in the support inbox (unread = customer messages since).
  adminReadAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ComplaintMessage[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([assignedToId, status])
  @@index([priority, status])
  @@index([sellerId, sellerRespondedAt])
  @@map("complaints")
}

// One turn in a support conversation. Internal notes are agent-only.
model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // CUSTOMER | AGENT | SYSTEM
  authorRole  String
  body        String
  attachments String[]  @default([])
  // Internal notes never reach the shopper.
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
  @@map("complaint_messages")
}

// A seller-funded discount on their own listings. The discount comes off the
// line price at checkout, so payouts, invoices and refunds all see the real
// amount the shopper paid.
model Promotion {
  id          String         @id @default(cuid())
  sellerId    String
  seller      SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Optional shopper-facing code. Null = applies automatically.
  code        String?        @unique
  scope       PromotionScope @default(STORE)
  kind        PromotionKind  @default(PERCENT)
  // Percent (1–90) or flat paise off, depending on `kind`.
  value       Int
  maxDiscountPaise Int?
  // Minimum eligible subtotal from this seller before it kicks in.
  minOrderPaise    Int       @default(0)
  startAt     DateTime
  endAt       DateTime
  // Redemption caps; null = unlimited.
  usageLimit   Int?
  perUserLimit Int?
  usedCount    Int           @default(0)
  // Running total of the discount given, for the seller's ROI panel.
  discountGivenPaise Int     @default(0)
  state       PromotionState @default(DRAFT)
  isFeatured  Boolean        @default(false)
  // Targets for PRODUCT / CATEGORY scope.
  productIds  String[]       @default([])
  categoryIds String[]       @default([])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  redemptions PromotionRedemption[]
  orderItems  OrderItem[]

  @@index([sellerId, state])
  @@index([state, startAt, endAt])
  @@map("promotions")
}

// One row per order line a promotion discounted — the usage/ROI trail.
model PromotionRedemption {
  id            String    @id @default(cuid())
  promotionId   String
  promotion     Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Gross value of the discounted lines, and what came off them.
  grossPaise    Int
  discountPaise Int
  createdAt     DateTime  @default(now())

  @@index([promotionId, createdAt])
  @@index([userId, promotionId])
  @@map("promotion_redemptions")
}

// Append-only record of everything that changes state on the platform.
// Written by the audit middleware plus explicit calls for security events.
model AuditLog {
  id        String   @id @default(cuid())
  reference String   @unique // LOG-20260804-000123
  // Who acted. Null for anonymous or system-triggered work.
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Snapshot so the row still reads correctly if the account is deleted.
  actorName  String?
  actorEmail String?
  actorRole  String // ADMIN | SELLER | CUSTOMER | SYSTEM | GUEST
  // What was touched: USERS, PRODUCTS, ORDERS, PAYOUTS, SETTINGS, AUTH…
  module    String
  // Human-readable action, e.g. "Seller suspended".
  action    String
  // The record it happened to.
  entityType String?
  entityId   String?
  summary    String
  // Request/response detail: method, path, status, changed fields.
  metadata   Json?
  severity   AuditSeverity @default(LOW)
  status     AuditStatus   @default(SUCCESS)
  ipAddress  String?
  userAgent  String?
  deviceType String? // MOBILE | TABLET | DESKTOP | OTHER
  // How long the request took, in milliseconds.
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([module, createdAt])
  @@index([actorId, createdAt])
  @@index([severity, createdAt])
  @@index([status, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. ORDER_PLACED, SELLER_APPROVED, ...
  title     String
  body      String
  // Optional deep link + thumbnail so a row can carry a CTA and an image.
  linkHref  String?
  imageUrl  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Landing-page content (admin-managed)
// ---------------------------------------------------------------------------

// Hero carousel slide. `highlight` is the gold-rendered word inside `headline`.
model HomeBanner {
  id             String   @id @default(cuid())
  headline       String
  highlight      String?
  subtext        String?
  imageUrl       String?
  primaryLabel   String   @default("Shop Now")
  primaryHref    String   @default("/products")
  secondaryLabel String?
  secondaryHref  String?
  // FULL_IMAGE: the image is the whole banner (its text and buttons baked
  // in), one link, nothing drawn on top; altText is then required.
  imageMode      BannerImageMode @default(DESIGNED)
  altText        String?
  // Shown instead of imageUrl on phones (below 640px); null: imageUrl everywhere.
  mobileImageUrl String?
  /// The point (percent across, percent down) that must stay in view at every width.
  focalX         Int      @default(50)
  focalY         Int      @default(50)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("home_banners")
}

enum BannerImageMode {
  DESIGNED // our headline and buttons, the image beside or behind them
  FULL_IMAGE // the image is the banner
}

enum PromoPlacement {
  PROMO_CARD // 4-card row under the trust strip
  PROMO_STRIP // 3 wide strips lower on the page
}

// Admin-managed promo tile (category sales, festivals, ...).
model PromoTile {
  id        String         @id @default(cuid())
  placement PromoPlacement
  title     String
  subtitle  String? // discount line, e.g. "Up to 60% Off"
  imageUrl  String?
  href      String         @default("/products")
  imageMode BannerImageMode @default(DESIGNED)
  altText   String?
  mobileImageUrl String?
  /// The point (percent across, percent down) that must stay in view at every width.
  focalX         Int      @default(50)
  focalY         Int      @default(50)
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([placement, isActive, sortOrder])
  @@map("promo_tiles")
}

// "Deals of the Day" window. The landing shows the active deal whose window
// contains now; when it expires the next scheduled one (if any) takes over.
model Deal {
  id        String   @id @default(cuid())
  title     String   @default("Deals of the Day")
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items DealItem[]

  @@index([isActive, startAt, endAt])
  @@map("deals")
}

model DealItem {
  id        String  @id @default(cuid())
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@unique([dealId, productId])
  @@map("deal_items")
}

// Newsletter signups from the landing page (admin can view/export).
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------
// Inventory & warehouses
//
// `ProductVariant.stock` stays the single number checkout guards against — every
// existing query keeps working. These models describe *where* that stock sits
// and *how* it got there: StockLocation splits the variant total across
// warehouses (the sum always equals ProductVariant.stock) and StockMovement is
// the append-only ledger behind every change.
// ---------------------------------------------------------------------------

model Warehouse {
  id           String   @id @default(cuid())
  // Short human code used on transfers and purchase orders, e.g. DEL-01.
  code         String   @unique
  name         String
  addressLine  String?
  city         String
  state        String
  pincode      String?
  contactName  String?
  contactPhone String?
  // Inactive warehouses keep their history but take no new stock.
  isActive     Boolean  @default(true)
  // Where stock lands when nothing more specific is chosen. Exactly one row
  // should carry this; the service repairs it if that ever stops being true.
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  locations       StockLocation[]
  movementsFrom   StockMovement[] @relation("MovementFrom")
  movementsTo     StockMovement[] @relation("MovementTo")
  purchaseOrders  PurchaseOrder[]
  transfersOut    StockTransfer[] @relation("TransferFrom")
  transfersIn     StockTransfer[] @relation("TransferTo")

  @@index([isActive])
  @@map("warehouses")
}

// How much of one variant sits in one warehouse.
model StockLocation {
  id          String         @id @default(cuid())
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int            @default(0)
  // Below this, the row shows up in "Low stock alerts" with a reorder action.
  reorderLevel Int           @default(0)
  // Cycle counting — drives the stock-accuracy panel. `lastCountedQty` is what
  // a human actually found on the shelf at `lastCountedAt`.
  lastCountedAt  DateTime?
  lastCountedQty Int?
  // True when the last count matched the system figure exactly.
  lastCountMatched Boolean?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@index([warehouseId, quantity])
  @@map("stock_locations")
}

enum StockMovementType {
  RECEIPT // stock arrived from a supplier or an opening balance
  DISPATCH // stock left for a customer order
  TRANSFER // moved between two warehouses
  ADJUSTMENT // manual correction, damage, cycle count
  RETURN // a customer return put back on the shelf
}

// Append-only ledger. One row per stock change, never edited or deleted.
model StockMovement {
  id              String            @id @default(cuid())
  type            StockMovementType
  variantId       String
  variant         ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // Always positive; `type` and the warehouse columns say which way it went.
  quantity        Int
  fromWarehouseId String?
  fromWarehouse   Warehouse?        @relation("MovementFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?        @relation("MovementTo", fields: [toWarehouseId], references: [id])
  // Free-text why, shown in the movements table.
  reason          String?
  // Order number, PO number or transfer number this belongs to.
  reference       String?
  // Who did it — null for automatic movements like a checkout dispatch.
  actorId         String?
  actor           User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([variantId, createdAt])
  @@map("stock_movements")
}

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contactName String?
  email       String?
  phone       String?
  city        String?
  state       String?
  gstin       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT // still being written, nothing on order
  ORDERED // sent to the supplier; the quantity counts as incoming
  PARTIAL // some lines received
  RECEIVED // fully received
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  receivedAt  DateTime?
  notes       String?
  createdById String?
  createdBy   User?               @relation("PurchaseOrderAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityOrdered Int
  quantityReceived Int           @default(0)
  // What the platform pays the supplier per unit, in paise.
  unitCostPaise   Int            @default(0)

  @@unique([purchaseOrderId, variantId])
  @@map("purchase_order_items")
}

enum StockTransferStatus {
  PENDING // raised, stock still at the source
  IN_TRANSIT // dispatched from the source, not yet received
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id              String              @id @default(cuid())
  transferNumber  String              @unique
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          StockTransferStatus @default(PENDING)
  notes           String?
  createdById     String?
  createdBy       User?               @relation("StockTransferAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  dispatchedAt    DateTime?
  completedAt     DateTime?

  items StockTransferItem[]

  @@index([status, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String         @id @default(cuid())
  transferId String
  transfer   StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int

  @@unique([transferId, variantId])
  @@map("stock_transfer_items")
}

enum FeeChangeStatus {
  SCHEDULED
  APPLIED
  CANCELLED
}

/// A change to the commercial rules announced ahead (owner's Batch 2): at
/// least 30 days' notice to sellers by email, SMS and the dashboard, applied
/// automatically on its date.
model ScheduledFeeChange {
  id          String          @id @default(cuid())
  /// The partial commercial rules it applies (merged over what is in force then).
  patch       Json
  /// What changes, in words, as sellers were told.
  summary     String
  effectiveAt DateTime
  status      FeeChangeStatus @default(SCHEDULED)
  createdById String
  createdAt   DateTime        @default(now())
  appliedAt   DateTime?
  cancelledAt DateTime?

  @@index([status, effectiveAt])
  @@map("scheduled_fee_changes")
}

/// A batch of try-on credits (free grant, pack, admin top-up): spent oldest-
/// expiring first, and what is left at expiresAt lapses (null = never).
model TryOnCreditLot {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// FREE_GRANT | PURCHASE | ADMIN | LEGACY
  source    String
  credits   Int
  remaining Int
  expiresAt DateTime?
  createdAt DateTime      @default(now())

  @@index([sellerId, remaining])
  @@index([expiresAt])
  @@map("tryon_credit_lots")
}

// Every credit movement on a seller's AI Try-On balance: the launch grant,
// purchased packs, and one row per shopper run.
model TryOnCreditLedger {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String // FREE_GRANT | PURCHASE | RUN
  note      String?
  createdAt DateTime      @default(now())

  @@index([sellerId, createdAt])
  @@map("tryon_credit_ledger")
}

/// What a ledger line is. Signed amounts carry the direction, so the type says
/// only why the money moved.
enum SellerLedgerType {
  SALE_EARNING // + line total, posted on delivery
  COMMISSION // - marketplace commission on that sale
  PLATFORM_FEE // - fixed per-unit platform fee
  GATEWAY_FEE // - payment gateway / collection charge
  TDS // - section 194-O withholding
  LATE_DISPATCH_PENALTY // - shipped after the dispatch window
  PENALTY_WAIVER // + an admin forgave a penalty
  RETURN_REVERSAL // - a delivered line came back; its earning and fees are undone
  PROMOTION_CREDIT_PURCHASE // + seller bought promotion credits
  PROMOTION_CREDIT_SPEND // - promotion credits spent on a placement
  PAYOUT // - money transferred to the seller's bank
  ADJUSTMENT // +/- manual or system correction, always with a note
  // Appended later (Postgres adds enum values at the end): the fixed fees
  // the pricing calculator posts alongside PLATFORM_FEE.
  DELIVERY_FEE // - fixed delivery fee charged to the seller, per shipment
  CLOSING_FEE // - fixed closing fee, per unit
  GST_TCS // - GST TCS the marketplace collects under s.52 CGST Act
  GT_CHARGE // - goods transfer charge, per unit
  SELLER_CANCEL_PENALTY // - the seller cancelled their part of an order
  FORWARD_FREIGHT // - Delhivery's forward freight for a delivered parcel (GST included)
  FREIGHT_ADJUSTMENT // +/- the freight re-priced after Delhivery's charged weight changed
  COD_FEE // - Delhivery's COD collection charge on a delivered COD parcel (GST included)
  RTO_FREIGHT // - Delhivery's charge for bringing an undelivered parcel back (GST included)
  RETURN_FREIGHT // - Delhivery's charge for collecting a customer return (reverse pickup, GST included)
  // Batch 2 — Clowe's charges (each exclusive of GST; the GST is its own entry):
  HANDLING_FEE // - per-unit handling fee, by selling price slab
  CLOWE_FEE_GST // - GST on a Clowe charge (chargeType says which)
  ADMIN_PENALTY // - an admin's penalty (counterfeit listing, inaccurate try-on data), with a reason
  SUBSCRIPTION_FEE // - the seller's plan, monthly
  AD_SPEND // - advertising: clicks, packages, placements
  SPONSORSHIP_FEE // - sponsorship placements
  TRYON_CREDITS // - AI Try-On credit packs
  AD_CREDIT_GRANT // + advertising credit given (welcome, plan) — usable only on ads
}

/// Settlement money can be paid out; promotion credits never can. Keeping them
/// in separate buckets means a promotion top-up cannot leak into a payout, and
/// a penalty cannot eat ad credits, without any code having to remember that.
enum SellerLedgerBucket {
  SETTLEMENT
  // The Seller Wallet: topped up through the payment gateway; Clowe's charges come from it first.
  PROMOTION
  // Advertising credit (welcome credit, plan credit): spent only on advertising.
  AD_CREDIT
}

/// The seller's money, one signed row per event. Balances are sums over this
/// table, never stored, so there is nothing to drift. The unique pairs below
/// are what make posting idempotent: a delivery, a penalty, a waiver or a
/// payout can only ever land once against the thing it is about.
model SellerLedgerEntry {
  id          String             @id @default(cuid())
  sellerId    String
  seller      SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type        SellerLedgerType
  bucket      SellerLedgerBucket
  // Signed, in paise: earnings positive, deductions negative.
  amountPaise Int
  orderId     String?
  orderItemId String?
  orderItem   OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  payoutId    String?
  payout      Payout?            @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  // The ad placement a promotion credit was spent on (or refunded for).
  adId        String?
  ad          Ad?                @relation(fields: [adId], references: [id], onDelete: SetNull)
  // The top-up a promotion credit came from; one purchase credits once.
  purchaseId  String?
  purchase    PromotionCreditPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  note        String?
  // GST_TCS only: the net taxable value (ex-GST) the TCS was taken on, as
  // calculated when it was posted. GSTR-8 reports it.
  taxablePaise Int?
  /// CLOWE_FEE_GST entries: the charge the GST is on (a SellerLedgerType value).
  chargeType String?
  // Uniqueness for posters the pairs below cannot express, e.g. one
  // late-dispatch penalty per order and seller: "late-dispatch:<order>:<seller>".
  idempotencyKey String? @unique
  // The admin behind a manual entry; null for entries the system posted.
  createdById String?
  createdBy   User?              @relation("SellerLedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())

  @@unique([orderItemId, type])
  @@unique([payoutId, type])
  @@unique([adId, type])
  @@unique([purchaseId, type])
  @@index([sellerId, bucket, createdAt])
  @@map("seller_ledger_entries")
}

/// A seller buying promotion credits through the payment gateway. The row is
/// the pending payment; the money only exists once the ledger entry that
/// points back here is posted, which the (purchaseId, type) pair allows once.
model PromotionCreditPurchase {
  id                String        @id @default(cuid())
  sellerId          String
  seller            SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amountPaise       Int
  provider          String        @default("mock")
  providerOrderId   String?
  providerPaymentId String?
  status            CreditPurchaseStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  ledgerEntries SellerLedgerEntry[]

  @@index([sellerId, createdAt])
  @@map("promotion_credit_purchases")
}

/// One results-page search, kept only in aggregate.
///
/// Deliberately holds nothing that identifies a person: no user id, no IP, no
/// session, no user agent. Which individual searched for what is a liability;
/// what the catalog fails to answer is the asset. Rows expire on a schedule
/// (see searchQueryCleanup) so the table cannot grow without bound.
///
/// Suggest-endpoint keystrokes are never logged — that fires per character and
/// would fill this with prefixes of real queries.
model SearchQuery {
  id String @id @default(cuid())

  /// Exactly what was typed, trimmed. The one field that could in principle
  /// carry something personal, and the only one the feature cannot work
  /// without: improving the synonym map means reading the actual words.
  query String
  /// Lowercased, whitespace-collapsed — what identical searches group on.
  normalized String

  /// What the parser made of it: price bounds in paise, brands, inferred
  /// category, sort. Stored so a zero-result row can be diagnosed without
  /// re-running the parser, which may have changed since.
  parsedFilters Json?

  /// How many products came back. 0 is the interesting case.
  resultCount Int
  /// fts | trigram | filters-only | none — which path answered.
  strategy String
  /// Whether a filter had to be dropped to return anything.
  relaxed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([normalized])
  @@index([resultCount, createdAt])
  @@index([createdAt])
  @@map("search_queries")
}

/// Content-Security-Policy violations the browsers report, grouped: one row
/// per (directive, blocked source, page path, disposition) with a count, so a
/// noisy page is one row, not a million. No query strings or full URLs are
/// kept, only origins and paths.
model CspReport {
  id          String   @id @default(cuid())
  /// sha256 of the grouping key below.
  fingerprint String   @unique
  directive   String
  /// Origin or scheme of what was blocked, or 'inline' / 'eval'.
  blocked     String
  /// Path of the page that triggered it.
  page        String
  /// 'report' (Report-Only) or 'enforce'.
  disposition String
  /// Start of the offending inline script, when the browser sends one.
  sample      String?
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
  @@map("csp_reports")
}

/// What an uploaded file is for. Decides who may attach it and see it.
enum AssetPurpose {
  RETURN_PHOTO // private: the buyer, that item's seller, admins
  TRYON_PHOTO // private: the shopper, admins
  TRYON_RESULT // private: the shopper, admins
  PACKING_VIDEO // private: the seller, admins
  SELLER_DOCUMENT // private: a seller's application documents — that seller, admins
  RETURN_VIDEO // private: the buyer's unboxing video for a claim — the buyer, that item's seller, admins
}

/// A stored file. Rows that use it hold "asset:<id>", never a URL: the API
/// turns the reference into a short-lived signed URL for a viewer it has
/// already authorised. Provider and key say where the bytes are, so a file
/// stays readable after the configured provider changes.
model Asset {
  id          String       @id @default(cuid())
  /// Storage provider holding the bytes: 'local' or 'r2'.
  provider    String
  /// The object's key in that provider's private store.
  key         String
  purpose     AssetPurpose
  contentType String
  bytes       Int
  /// Who uploaded it; attaching it to anything requires being this user.
  ownerId     String?
  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  /// Set when the bytes are deleted (retention, replacement). The row stays so
  /// a reference resolves to "gone" rather than to an error.
  deletedAt   DateTime?

  @@unique([provider, key])
  @@index([ownerId])
  @@index([purpose, createdAt])
  @@map("assets")
}

/// A seller's packing clip for their part of an order: required before
/// dispatch, private (that seller and admins, never the buyer), and kept until
/// 45 days after delivery and while a return on the order is open.
model OrderPackingVideo {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// asset:<id> reference to the private file.
  fileRef    String
  uploadedAt DateTime      @default(now())
  /// Set when retention ends and the file is deleted; the row stays as the record.
  deletedAt  DateTime?

  @@unique([orderId, sellerId])
  @@index([deletedAt, uploadedAt])
  @@map("order_packing_videos")
}

enum ProductRevisionStatus {
  DRAFT // saved by the seller, not sent for review
  PENDING // waiting for an admin
  REJECTED // an admin said no; the live listing never changed
}

/// A content edit to a live listing. The listing stays on the storefront, and
/// in carts, exactly as approved until an admin approves this; then the edit
/// replaces it. Price, stock and the other operational fields never come here:
/// they save straight onto the listing. One per product: a newer edit replaces
/// the open one, and approval deletes it.
model ProductRevision {
  id              String                @id @default(cuid())
  productId       String                @unique
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  status          ProductRevisionStatus
  /// The proposed content (services/productRevisions.ts, ListingContent).
  content         Json
  rejectionReason String?
  submittedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, submittedAt])
  @@map("product_revisions")
}

/// A Delhivery COD remittance report an admin uploaded: each row matched to a
/// parcel by AWB and amount. A matched row marks the parcel remitted, which is
/// what makes its COD lines payable to the seller.
model CodRemittanceImport {
  id           String   @id @default(cuid())
  /// The admin who uploaded it (kept as an id: the report outlives accounts).
  uploadedById String?
  fileName     String?
  rowCount     Int
  matched      Int      @default(0)
  mismatched   Int      @default(0)
  unknown      Int      @default(0)
  duplicate    Int      @default(0)
  createdAt    DateTime @default(now())
  rows         CodRemittanceRow[]

  @@index([createdAt])
  @@map("cod_remittance_imports")
}

model CodRemittanceRow {
  id          String              @id @default(cuid())
  importId    String
  import      CodRemittanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  awbNumber   String
  amountPaise Int
  reference   String?
  /// As the report wrote it.
  remittedOn  String?
  shipmentId  String?
  /// MATCHED | MISMATCH | UNKNOWN | DUPLICATE
  status      String
  note        String?
  createdAt   DateTime            @default(now())

  @@index([awbNumber])
  @@index([importId])
  @@map("cod_remittance_rows")
}

/// Every AI call (owner's overnight run): what for, by whom, its tokens and
/// cost — the monthly budget, the per-user daily limits and the admin's usage
/// view all read from here.
model AiUsage {
  id           String   @id @default(cuid())
  task         String
  provider     String
  model        String
  /// u:<userId>, or ip:<address> for a signed-out visitor; null for system calls.
  userKey      String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costPaise    Float    @default(0)
  ok           Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userKey, createdAt])
  @@map("ai_usage")
}

/// Outgoing email (Hostinger SMTP, from no-reply@cloweshop.com): queued, sent
/// in the background with retries, and held under a daily cap.
model EmailOutbox {
  id            String    @id @default(cuid())
  /// One email per source (e.g. n:<notificationId>), so nothing is sent twice.
  dedupeKey     String?   @unique
  kind          String
  toEmail       String
  userId        String?
  subject       String
  html          String
  text          String
  /// PENDING, SENDING, SENT or FAILED (gave up after the last retry).
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([sentAt])
  @@index([createdAt])
  @@map("email_outbox")
}
