{
  "name": "@clowe/api",
  "version": "0.1.0",
  "private": true,
  "description": "Clowe REST API — standalone backend consumed by web (and later mobile)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:seed:inventory": "tsx prisma/seedInventory.ts",
    "db:localize-images": "tsx prisma/localizeImages.ts",
    "seed:tryon-demo": "tsx scripts/seedTryOnDemoProduct.ts",
    "tryon:check": "tsx scripts/tryonCheck.ts",
    "tryon:e2e": "node scripts/tryonE2E.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@clowe/shared": "*",
    "@prisma/client": "^5.19.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.4.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.9.0",
    "prisma": "^5.19.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  }
}
