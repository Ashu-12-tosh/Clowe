# --- Server ---
PORT=4400
NODE_ENV=development

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL="postgresql://clowe:clowe_dev_password@localhost:5433/clowe?schema=public"

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:4300

# --- Web app URL, used for the QR codes on seller labels/invoices. Defaults to the first CORS origin. ---
# WEB_PUBLIC_URL=http://localhost:3000

# --- Auth ---
# Generate a strong secret for production: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-dev-only-secret
JWT_ACCESS_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=90

# --- OTP ---
# 'mock' prints the OTP to the API console (dev). MSG91/Twilio come later.
OTP_PROVIDER=mock
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5

# --- Admin ---
# This phone number gets the ADMIN role when you run the seed script.
ADMIN_PHONE=9999999999

# --- AI Try-On ---
# 'auto' = use FASHN when FASHN_API_KEY is set, else the free mock provider.
TRYON_PROVIDER=auto
# Get a key at https://fashn.ai -> Settings -> API. Adding it here switches to
# real AI try-on with no code change; restart the API afterwards.
# Verify with: npm run tryon:check --workspace=@clowe/api
# FASHN_API_KEY=fa-...
# Model: tryon-v1.6 is 1 credit per image; tryon-max is sharper and costs more.
FASHN_MODEL=tryon-v1.6
# performance ~5s, balanced ~8s, quality ~12-17s.
FASHN_MODE=balanced
# Whole-run budget in ms. The HTTP request is held open this long, so keep it
# under any proxy/CDN timeout in front of the API (Cloudflare cuts off at 100s).
TRYON_TIMEOUT_MS=75000
TRYON_DAILY_LIMIT=10
# Cost logged per real try-on, in paise (for accounting).
TRYON_COST_PAISE=650

# --- AI features (description generator, review summary, voice search, support chat) ---
# 'auto' = use Claude when ANTHROPIC_API_KEY is set, else the free mock provider.
AI_PROVIDER=auto
# Get a key at https://platform.claude.com → adding it enables real AI, no code changes.
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-4-8
