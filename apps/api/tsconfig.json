{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  // Tests and their fixtures live beside the code but are not shipped —
  // Vitest compiles them itself, and the production image has no test deps.
  "exclude": ["src/**/*.test.ts", "src/test"]
}
