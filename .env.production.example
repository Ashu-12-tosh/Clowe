# Clowe — production environment (copy to .env.production and fill in)
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# ============ REQUIRED ============
# Your public URL (no trailing slash). Also used for CORS + image URLs.
SITE_URL=https://yourdomain.com

# Postgres password — generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing secret — generate: openssl rand -hex 32
JWT_ACCESS_SECRET=

# KYC fingerprint key — generate: openssl rand -hex 32
# Set it once and never rotate it: a new key makes every verified PAN, GSTIN and
# bank account look changed, and every one of them gets re-verified (and re-billed).
KYC_FINGERPRINT_SECRET=
# Signs the short-lived links to private files (return photos, try-on photos,
# packing videos). Optional: JWT_ACCESS_SECRET is used when blank. openssl rand -hex 32
FILE_URL_SECRET=

# Cloudflare R2 for private files (see DEPLOY_RUNBOOK: "Private files in R2").
# Leave blank to keep them on the server's private volume.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=

# Your admin login phone (seeded with the ADMIN role)
ADMIN_PHONE=9999999999

# ============ OPTIONAL (defaults shown) ============
POSTGRES_USER=clowe
POSTGRES_DB=clowe

# --- Real providers: fill these to go live, leave for mock/dev behavior ---
# OTP SMS through the DLT-registered SMS panel. OTP_PROVIDER=smspanel sends real
# SMS once all five settings below are filled; with any missing it stays on the
# mock (codes print in `docker compose logs api`) and the boot log says which.
OTP_PROVIDER=mock
# https only, and the certificate must cover this host. Blank = https://alots.in
SMS_PANEL_BASE_URL=
SMS_PANEL_USERNAME=
SMS_PANEL_API_KEY=
# The 6-character DLT header (sender ID) and the DLT template ID of the OTP template.
SMS_PANEL_SENDER_ID=
SMS_PANEL_TEMPLATE_ID=
# The approved template text, character for character, with {#var#} where the
# code goes. Keep the single quotes: they stop # and $ in the text being read as
# a comment or a variable. (If the text has an apostrophe, use double quotes and
# write any $ as $$.)
SMS_PANEL_OTP_TEMPLATE=''

# Payments — set to razorpay + keys for real payments
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI try-on (fashn.ai) — key enables real try-on automatically
TRYON_PROVIDER=auto
FASHN_API_KEY=

# AI features (Claude) — key enables real AI automatically
AI_PROVIDER=auto
ANTHROPIC_API_KEY=

# WhatsApp/SMS/email + delivery partner (mock logs to console for now)
MESSAGING_PROVIDER=mock
SHIPPING_PROVIDER=mock

# Seller KYC (Cashfree Verification Suite) — both keys switch it on automatically.
# Until then KYC runs on the mock, which marks everything verified: not real checks.
KYC_PROVIDER=auto
# sandbox never bills; production does. Verification only — each Cashfree product
# has its own environment, so this can go live while others stay in sandbox.
CASHFREE_VERIFICATION_ENV=sandbox
CASHFREE_VERIFICATION_CLIENT_ID=
CASHFREE_VERIFICATION_CLIENT_SECRET=
# Only for public-key 2FA; leave empty if the server IP is allowlisted in Cashfree.
# PEM on one line, with \n where the line breaks go.
CASHFREE_VERIFICATION_PUBLIC_KEY=
