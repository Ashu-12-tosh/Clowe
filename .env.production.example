# Clowe — production environment (copy to .env.production and fill in)
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# ============ REQUIRED ============
# Your public URL (no trailing slash). Also used for CORS + image URLs.
SITE_URL=https://yourdomain.com

# Postgres password — generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT signing secret — generate: openssl rand -hex 32
JWT_ACCESS_SECRET=

# KYC fingerprint key — generate: openssl rand -hex 32
# Set it once and never rotate it: a new key makes every verified PAN, GSTIN and
# bank account look changed, and every one of them gets re-verified (and re-billed).
KYC_FINGERPRINT_SECRET=
# Signs the short-lived links to private files (return photos, try-on photos,
# packing videos). Optional: JWT_ACCESS_SECRET is used when blank. openssl rand -hex 32
FILE_URL_SECRET=

# Cloudflare R2 for private files (see DEPLOY_RUNBOOK: "Private files in R2").
# Leave blank to keep them on the server's private volume.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=

# Your admin login phone (seeded with the ADMIN role)
ADMIN_PHONE=9999999999

# ============ OPTIONAL (defaults shown) ============
POSTGRES_USER=clowe
POSTGRES_DB=clowe

# --- Real providers: fill these to go live, leave for mock/dev behavior ---
# OTP SMS through the DLT-registered SMS panel. OTP_PROVIDER=smspanel sends real
# SMS once all five settings below are filled; with any missing it stays on the
# mock (codes print in `docker compose logs api`) and the boot log says which.
OTP_PROVIDER=mock
# https only, and the certificate must cover this host. Blank = https://alots.in
SMS_PANEL_BASE_URL=
SMS_PANEL_USERNAME=
SMS_PANEL_API_KEY=
# The 6-character DLT header (sender ID) and the DLT template ID of the OTP template.
SMS_PANEL_SENDER_ID=
SMS_PANEL_TEMPLATE_ID=
# The approved template text, character for character, with its one DLT
# variable ({#num#}, {#var#}, …) where the code goes. Use double quotes and write
# a line break as \n: compose turns it into a real one (single quotes would
# not). Inside the double quotes write any $ as $$ and any " as \".
#   SMS_PANEL_OTP_TEMPLATE="{#num#} is your code. Do not share it.\nCLOWEP"
SMS_PANEL_OTP_TEMPLATE=""

# Payments — mock until going live; cashfree + the Cashfree PG keys for real
# payments. sandbox never moves money; production only on this server.
# Webhook URL to set in the Cashfree dashboard (payments + refunds):
#   https://<SITE_URL host>/api/payments/cashfree/webhook
PAYMENT_PROVIDER=mock
CASHFREE_PG_ENV=sandbox
CASHFREE_PG_CLIENT_ID=
CASHFREE_PG_CLIENT_SECRET=
# How sellers are paid: payouts (collected into Clowe's account, paid by
# Cashfree Payouts after the hold) or easy_split (needs Easy Split active,
# deferred vendor settlement on, and the proportional refund debit off).
SETTLEMENT_MODE=payouts
# Razorpay, kept for reference; unused with Cashfree.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seller payouts — mock until going live; cashfree + the Payouts keys for real
# transfers. Production needs this server's IPv4 address allowlisted in the
# Payouts dashboard (or the public key for signature 2FA below).
# Webhook to add in the Payouts dashboard, version V2 (V1 is refused):
#   https://<SITE_URL host>/api/payouts/cashfree/webhook
# Its signature is checked as soon as the keys are set, even on the mock.
# With cashfree every payout waits for an admin (payoutAutoApprove is ignored).
PAYOUT_PROVIDER=mock
CASHFREE_PAYOUT_ENV=sandbox
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
# Only for public-key 2FA; PEM on one line, with \n where the line breaks go.
CASHFREE_PAYOUT_PUBLIC_KEY=

# AI try-on (fashn.ai) — key enables real try-on automatically
TRYON_PROVIDER=auto
FASHN_API_KEY=

# AI features (Claude) — key enables real AI automatically
AI_PROVIDER=auto
ANTHROPIC_API_KEY=

# WhatsApp/SMS/email (mock logs to console for now)
MESSAGING_PROVIDER=mock

# Delhivery, the only courier. mock = no network, no money. Going live is
# staging first (DELHIVERY_ENV=staging, the staging token); production needs
# the production token, and DELHIVERY_PRODUCTION_WRITES=true before anything
# real is booked, picked up or cancelled.
SHIPPING_PROVIDER=mock
DELHIVERY_ENV=staging
DELHIVERY_API_TOKEN=
DELHIVERY_PRODUCTION_WRITES=false
# The secret Delhivery sends with pushed scans (we choose it); unset = polling only.
DELHIVERY_WEBHOOK_TOKEN=

# Seller KYC (Cashfree Secure ID). With both keys set, admins get "Verify with
# Cashfree" per document (one billed call per press, stored answers reused);
# nothing else ever calls it. A check is VERIFIED only when an admin marks it,
# and only after Cashfree passed it. Without keys: manual review against the
# documents (the mock never verifies anything).
KYC_PROVIDER=auto
# sandbox never bills; production does. Verification only — each Cashfree product
# has its own environment, so this can go live while others stay in sandbox.
CASHFREE_VERIFICATION_ENV=sandbox
CASHFREE_VERIFICATION_CLIENT_ID=
CASHFREE_VERIFICATION_CLIENT_SECRET=
# Only for public-key 2FA; leave empty if the server IP is allowlisted in Cashfree.
# PEM on one line, with \n where the line breaks go.
CASHFREE_VERIFICATION_PUBLIC_KEY=
